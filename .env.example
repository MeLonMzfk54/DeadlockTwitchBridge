# Twitch Application (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret

# User OAuth token scopes:
#   channel:read:redemptions  — Channel Points → effects
#   user:read:chat            — shop vote via EventSub channel.chat.message (WebSocket)
#   user:write:chat           — announce vote start + how-to in chat (Helix Send Chat Message)
# Optional if Twitch requires bot-style chat auth for your app:
#   user:bot / channel:bot
# Generate via https://twitchtokengenerator.com/ or your own OAuth flow
TWITCH_ACCESS_TOKEN=your_user_access_token
TWITCH_REFRESH_TOKEN=your_refresh_token

# Broadcaster Twitch user ID (numeric). Leave empty to resolve from token.
TWITCH_BROADCASTER_ID=

# Game command transport: vconsole (dev/sandbox) or cfg-bind (official-safe)
GAME_COMMAND_MODE=vconsole

# cfg-bind mode (official-safe, no -insecure)
# Path to Deadlock cfg folder, e.g. C:\Program Files (x86)\Steam\steamapps\common\Deadlock\game\citadel\cfg
DEADLOCK_CFG_DIR=
CFG_BIND_FILENAME=twitch_bridge_effect.cfg
CFG_TRIGGER_KEY=F10
CFG_BIND_COMMAND_DELAY_MS=75
# Match game window by process name (deadlock.exe). Optional extra title filter.
DEADLOCK_PROCESS_NAME=deadlock
DEADLOCK_WINDOW_TITLE=

# Game telemetry (twitch_bridge_events.js). Optional — auto-detects console.log near cfg/Steam.
# Launch Deadlock with -condebug so the log file is written.
DEADLOCK_GAME_DIR=
DEADLOCK_CONSOLE_LOG=

# screen_flip overlay (Windows). Falls back to DEADLOCK_* for process/title.
# Deadlock must be Borderless Windowed. OBS: Display Capture (not Game Capture).
SCREEN_FLIP_PROCESS_NAME=deadlock
SCREEN_FLIP_WINDOW_TITLE=
SCREEN_FLIP_FPS=45
# Reserved for multi-monitor fallback when HWND lookup fails (optional).
SCREEN_FLIP_MONITOR_INDEX=

# Deadlock VConsole connection (GAME_COMMAND_MODE=vconsole)
VCONSOLE_HOST=127.0.0.1
VCONSOLE_PORT=29000
VCONSOLE_RECONNECT_MS=5000

# HTTP control panel + OBS overlay
HTTP_HOST=127.0.0.1
HTTP_PORT=3920

# Set to true to skip Twitch and use test UI / API only
TEST_MODE=false

# Allow cheat-flagged effects (not recommended for retail matchmaking)
ALLOW_CHEAT_EFFECTS=false

# Allow destructive effects (disconnect) via Twitch rewards
ALLOW_DESTRUCTIVE_EFFECTS=false

# Max queued effect activations
MAX_QUEUE_SIZE=10

# Random Shop vote durations (milliseconds). Used only as seed when
# config/shop-vote.json does not exist yet. Live prefs live in that JSON
# (also editable via /control → POST /api/shop-vote/settings).
SHOP_VOTE_CATEGORY_MS=25000
SHOP_VOTE_TIER_MS=25000
# Pause after a successful purchase before autoStart begins a new vote.
SHOP_VOTE_RESTART_MS=25000
# Chat votes need EventSub channel.chat.message (scope user:read:chat above).
# Vote-start announcements need Helix chat send (scope user:write:chat above).
# Mock bot is off by default; enable in /control or POST /api/shop-vote/mock.
# Full setup guide: RANDOM_SHOP.md
